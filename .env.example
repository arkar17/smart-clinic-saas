# Copy to .env for local use. Local placeholder values only — generate your own; never commit .env.
POSTGRES_USER=smartclinic
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=smartclinic_dev
# Host-side tools (pnpm commands outside Docker) use this URL.
DATABASE_URL=postgresql://smartclinic:change-me-local-only@localhost:5432/smartclinic_dev
# Integration/E2E tests: a disposable database whose name ends in _test on a local host (enforced by apps/api/test/global-setup.ts).
TEST_DATABASE_URL=postgresql://smartclinic:change-me-local-only@localhost:5432/smartclinic_test
APP_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
# true behind HTTPS; must be true when NODE_ENV=production (enforced at start-up).
COOKIE_SECURE=false
# Number of trusted reverse-proxy hops in front of the API.
TRUST_PROXY=1
# HMAC pepper for IP hashes (≥ 16 chars): `openssl rand -base64 24`
IP_HASH_PEPPER=change-me-local-development-only
# ADR-011: base64 of 32 random bytes: `openssl rand -base64 32`
IDEMPOTENCY_ENC_KEY=bG9jYWwtZGV2LW9ubHktaWRlbXBvdGVuY3kta2V5MzI=
LOG_LEVEL=info
PORT=3000
# Shows the "Demo — fictional data" banner (FR-DEM-002).
VITE_DEMO=true
