# Copy to .env for local development. Fictional/local values only — never commit real secrets.
DATABASE_URL=postgresql://smartclinic:smartclinic@localhost:5432/smartclinic_dev
# Integration tests: a disposable database whose name ends in _test (guarded by apps/api/test/global-setup.ts)
TEST_DATABASE_URL=postgresql://smartclinic:smartclinic@localhost:5432/smartclinic_test
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
IP_HASH_PEPPER=change-me-local-development-only
LOG_LEVEL=info
PORT=3000
