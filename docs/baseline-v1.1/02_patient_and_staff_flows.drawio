br&gt;(membership active; clinic ACTIVE,&lt;br&gt;or SUSPENDED for CLINIC_ADMIN read-only)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="260" height="80" as="geometry"/></mxCell><mxCell id="e4" value="POST /api/auth/login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v5" value="403 NO_ACTIVE_MEMBERSHIP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="200" height="40" as="geometry"/></mxCell><mxCell id="e6" value="none" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="v3" target="v5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7" value="Auto-select the only clinic" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="600" y="40" width="200" height="50" as="geometry"/></mxCell><mxCell id="v8" value="S-03 Select clinic&lt;br&gt;(list: clinic, roles)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="200" height="60" as="geometry"/></mxCell><mxCell id="e9" value="exactly one" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="several" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;POST /api/auth/select-clinic&lt;/b&gt;&lt;br&gt;verify active membership of this user;&lt;br&gt;store active_clinic_id + active_member_id&lt;br&gt;(composite FK incl. user_id); rotate CSRF;&lt;br&gt;close old streams; audit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="870" y="60" width="300" height="110" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v7" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="choose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v8" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v14" value="Work in selected clinic&lt;br&gt;header shows clinic + switcher;&lt;br&gt;permissions = this membership's roles only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1240" y="75" width="260" height="80" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v11" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v16" value="Every request: re-validate membership,&lt;br&gt;clinic and account; X-Clinic-Id must equal selection" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1240" y="230" width="260" height="70" as="geometry"/></mxCell><mxCell id="e17" value="each call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v14" target="v16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v18" value="409 CLINIC_CONTEXT_MISMATCH&lt;br&gt;(stale tab → reload)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1560" y="230" width="200" height="60" as="geometry"/></mxCell><mxCell id="e19" value="header differs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="v16" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v20" value="403 CLINIC_SELECTION_REQUIRED&lt;br&gt;(membership deactivated / clinic suspended)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1240" y="360" width="260" height="60" as="geometry"/></mxCell><mxCell id="e21" value="not valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="v16" target="v20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="select another clinic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="v20" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="switch clinic (header)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v14" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;Membership deactivated in clinic A&lt;/b&gt; (FR-STF-003): A access lost within 60 s; streams for A closed; other memberships and the global account unaffected.&lt;br&gt;&lt;b&gt;Global account deactivated&lt;/b&