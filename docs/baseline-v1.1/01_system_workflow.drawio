<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Smart Clinic architecture generator" version="24.0.0"><diagram id="page1" name="1. System context &amp; deployment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b style='font-size:16px'&gt;Smart Clinic — system context and deployment (MVP)&lt;/b&gt;&lt;br&gt;Modular monolith; Docker Compose; single API instance + worker; one PostgreSQL database." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="v2" value="Public Patient&lt;br&gt;&lt;i&gt;mobile browser, no account&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;shape=mxgraph.basic.rect;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="v3" value="Receptionist / Clinic Admin&lt;br&gt;&lt;i&gt;desktop / tablet&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=mxgraph.basic.rect;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="v4" value="Doctor&lt;br&gt;&lt;i&gt;tablet / desktop&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=mxgraph.basic.rect;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="v5" value="Platform Administrator&lt;br&gt;&lt;i&gt;desktop&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;shape=mxgraph.basic.rect;" vertex="1" parent="1"><mxGeometry x="940" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="v6" value="Waiting-room display&lt;br&gt;&lt;i&gt;TV browser, display key&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;shape=mxgraph.basic.rect;" vertex="1" parent="1"><mxGeometry x="1240" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="v7" value="Printed clinic QR&lt;br&gt;&lt;i&gt;https://host/c/&amp;lt;slug&amp;gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="220" height="50" as="geometry"/></mxCell><mxCell id="e8" value="scan opens portal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v7" target="v2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v9" value="Docker host / deployment environment" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1640" height="640" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Reverse proxy&lt;/b&gt;&lt;br&gt;TLS termination, HSTS, security headers&lt;br&gt;proxy_buffering off for */stream" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="420" height="70" as="geometry"/></mxCell><mxCell id="e11" value="HTTPS (portal, token pages)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v2" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v4" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v5" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v6" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;web&lt;/b&gt; (container)&lt;br&gt;React + TypeScript + Vite + Tailwind SPA&lt;br&gt;static assets; routes: /c, /app, /platform, /display" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="380" height="80" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;api&lt;/b&gt; (container, Node.js + Express)&lt;br&gt;REST /api/* · Zod contracts · cookie sessions · RBAC&lt;br&gt;modules: identity, platform, clinic, scheduling, booking,&lt;br&gt;patients, queue, reporting, audit, realtime&lt;br&gt;SSE hub (in-process) · LISTEN clinic_event" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="450" width="460" height="120" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;worker&lt;/b&gt; (container, same image)&lt;br&gt;scheduler + job runner&lt;br&gt;hold expiry · day close · notification jobs · purge" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1100" y="450" width="380" height="90" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;db&lt;/b&gt; (PostgreSQL 16)&lt;br&gt;extensions: btree_gist, citext, pg_trgm, pgcrypto&lt;br&gt;exclusion &amp;amp; partial unique constraints&lt;br&gt;status-guard triggers · append-only audit_log&lt;br&gt;LISTEN/NOTIFY channel: clinic_event" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;shape=cylinder3;boundedLbl=1;size=12;" vertex="1" parent="1"><mxGeometry x="560" y="680" width="420" height="110" as="geometry"/></mxCell><mxCell id="e20" value="GET /, /c/*, /app/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v10" target="v16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="/api/* JSON + fetch-based SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v10" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="Prisma (SQL, transactions)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v17" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="NOTIFY clinic_event (on commit)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v19" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="SQL jobs (FOR UPDATE SKIP LOCKED);&lt;br&gt;writes clinic_event + pg_notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v18" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;migrate&lt;/b&gt; (one-shot)&lt;br&gt;prisma migrate deploy + raw SQL&lt;br&gt;seed / reset (fictional data)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1100" y="690" width="260" height="80" as="geometry"/></mxCell><mxCell id="e26" value="DDL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v25" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v27" value="&lt;b&gt;Not integrated in MVP (SRS 4.2)&lt;/b&gt;&lt;br&gt;No SMS / OTP / WhatsApp / email providers&lt;br&gt;No payments, insurance, EHR, labs&lt;br&gt;No native apps" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="380" height="90" as="geometry"/></mxCell><mxCell id="v28" value="Notes: single API instance (rate limiter and SSE hub in memory). Secrets via environment: SESSION_PEPPER, IP_HASH_PEPPER, IDEMPOTENCY_ENC_KEY, DATABASE_URL." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2. Request, transaction and event flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b style='font-size:16px'&gt;Write path: every state change is one transaction that also writes audit_log and clinic_event; SSE fan-out happens only after commit.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="v2" value="Request&lt;br&gt;(browser)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="180" height="70" as="geometry"/></mxCell><mxCell id="v3" value="requestId +&lt;br&gt;security headers" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="225" y="80" width="180" height="70" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v5" value="rate limiter&lt;br&gt;(public &amp;amp; login)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="80" width="180" height="70" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3" target="v5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7" value="authn:&lt;br&gt;session cookie | access token | display key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="635" y="80" width="180" height="70" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v5" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v9" value="clinic context&lt;br&gt;(selected membership +&lt;br&gt;X-Clinic-Id check | slug | token)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="180" height="70" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v7" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v11" value="clinic status gate&lt;br&gt;(ACTIVE; SUSPENDED read-only)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1045" y="80" width="180" height="70" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v9" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v13" value="permission check&lt;br&gt;(CAP-* matrix, own-scope)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="80" width="180" height="70" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v11" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v15" value="Zod validation&lt;br&gt;+ CSRF (staff) / Idempotency-Key (public)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1455" y="80" width="180" height="70" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v13" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Module service&lt;/b&gt;&lt;br&gt;state machine check (from → to)&lt;br&gt;business rules (BR-*)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1440" y="220" width="220" height="80" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v15" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;DB transaction&lt;/b&gt;&lt;br&gt;1. conditional UPDATE … WHERE status=:from AND version=:v&lt;br&gt;2. constraint-backed INSERT (exclusion / unique)&lt;br&gt;3. INSERT audit_log&lt;br&gt;4. INSERT clinic_event (PII-free)&lt;br&gt;5. SELECT pg_notify('clinic_event', id)&lt;br&gt;COMMIT (or ROLLBACK → 409/410/422)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="980" y="340" width="420" height="140" as="geometry"/></mxCell><mxCell id="e20" value="executes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v17" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v21" value="HTTP response&lt;br&gt;(success or error envelope)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1440" y="380" width="220" height="60" as="geometry"/></mxCell><mxCell id="e22" value="after commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v19" target="v21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;API LISTEN handler&lt;/b&gt;&lt;br&gt;loads clinic_event by id" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="980" y="560" width="260" height="60" as="geometry"/></mxCell><mxCell id="e24" value="NOTIFY delivered only on commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v19" target="v23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;SSE hub router&lt;/b&gt;&lt;br&gt;filter by clinic_id → audience rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="560" width="300" height="60" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v23" target="v25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v27" value="Staff stream&lt;br&gt;CA/RC: all clinic events" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="220" height="60" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v25" target="v27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v29" value="Doctor stream&lt;br&gt;doctor_id = own" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="220" height="60" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v25" target="v29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v31" value="Public entry stream&lt;br&gt;own entry + recomputed position" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="700" width="220" height="60" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v25" target="v31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v33" value="Display stream&lt;br&gt;tokens only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="700" width="220" height="60" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v25" target="v33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;worker scheduler&lt;/b&gt;&lt;br&gt;every 60 s: hold expiry&lt;br&gt;every 5 min: day close per clinic tz&lt;br&gt;every 10 s: notification_job poll&lt;br&gt;hourly: purge" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="280" height="110" as="geometry"/></mxCell><mxCell id="e36" value="same transaction pattern" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v35" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v37" value="Clients always reload a snapshot after (re)connecting; Last-Event-ID is advisory. Events carry IDs, status, token number and version only — staff UIs refetch names over REST." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
