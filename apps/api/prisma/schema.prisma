// Smart Clinic — SC-1 tables (Arch 11.1–11.11, 11.17). Hand-written SQL objects live in the migrations (ADR-019)
// and are listed in prisma/db-verify-manifest.json.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  NONE
  PLATFORM_ADMIN

  @@map("platform_role")
}

enum ClinicRole {
  CLINIC_ADMIN
  RECEPTIONIST
  DOCTOR

  @@map("clinic_role")
}

enum ClinicStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED

  @@map("clinic_status")
}

enum ScheduleExceptionKind {
  UNAVAILABLE
  MODIFIED_HOURS

  @@map("schedule_exception_kind")
}

enum PatientSource {
  QR_BOOKING
  QR_WALK_IN
  STAFF

  @@map("patient_source")
}

enum AppointmentChannel {
  PUBLIC
  STAFF

  @@map("appointment_channel")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED

  @@map("appointment_status")
}

enum CancelActor {
  PATIENT
  STAFF
  SYSTEM

  @@map("cancel_actor")
}

enum AccessTokenPurpose {
  BOOKING
  QUEUE
  DISPLAY

  @@map("access_token_purpose")
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED

  @@map("idempotency_state")
}

enum QueueSource {
  SCHEDULED
  QR_WALK_IN
  STAFF_WALK_IN

  @@map("queue_source")
}

enum QueueStatus {
  REGISTERED
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED

  @@map("queue_status")
}

enum ActorType {
  STAFF
  PUBLIC_PATIENT
  SYSTEM

  @@map("actor_type")
}

model User {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String       @unique @db.Citext
  displayName        String       @map("display_name") @db.VarChar(100)
  passwordHash       String       @map("password_hash")
  platformRole       PlatformRole @default(NONE) @map("platform_role")
  isActive           Boolean      @default(true) @map("is_active")
  deactivationReason String?      @map("deactivation_reason") @db.VarChar(200)
  mustChangePassword Boolean      @default(true) @map("must_change_password")
  failedLoginCount   Int          @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil        DateTime?    @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt  DateTime?    @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships    ClinicMember[]
  sessions       Session[]
  createdClinics Clinic[]
  auditEvents    AuditLog[]

  @@map("app_user")
}

model Session {
  idHash            Bytes     @id @map("id_hash")
  userId            String    @map("user_id") @db.Uuid
  csrfSecret        Bytes     @map("csrf_secret")
  activeClinicId    String?   @map("active_clinic_id") @db.Uuid
  activeMemberId    String?   @map("active_member_id") @db.Uuid
  selectedAt        DateTime? @map("selected_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(40)
  ipHash            Bytes?    @map("ip_hash")
  userAgent         String?   @map("user_agent") @db.VarChar(255)

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembership ClinicMember? @relation(fields: [activeClinicId, activeMemberId, userId], references: [clinicId, id, userId], onDelete: Restrict, onUpdate: Restrict, map: "session_active_membership_fkey")

  @@index([absoluteExpiresAt])
  @@map("session")
}

model Clinic {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String       @unique @db.Citext
  name                  String       @db.VarChar(120)
  address               String?      @db.VarChar(300)
  contactPhoneE164      String?      @map("contact_phone_e164") @db.VarChar(16)
  timezone              String       @db.VarChar(64)
  defaultPhoneRegion    String       @map("default_phone_region") @db.Char(2)
  status                ClinicStatus @default(PENDING_SETUP)
  statusReason          String?      @map("status_reason") @db.VarChar(200)
  activatedAt           DateTime?    @map("activated_at") @db.Timestamptz(6)
  suspendedAt           DateTime?    @map("suspended_at") @db.Timestamptz(6)
  privacyNotice         String?      @map("privacy_notice")
  slotGranularityMin    Int          @default(15) @map("slot_granularity_min") @db.SmallInt
  holdMinutes           Int          @default(10) @map("hold_minutes") @db.SmallInt
  minNoticeMin          Int          @default(60) @map("min_notice_min") @db.SmallInt
  horizonDays           Int          @default(30) @map("horizon_days") @db.SmallInt
  cancelCutoffMin       Int          @default(120) @map("cancel_cutoff_min") @db.SmallInt
  checkinBeforeMin      Int          @default(60) @map("checkin_before_min") @db.SmallInt
  checkinAfterMin       Int          @default(30) @map("checkin_after_min") @db.SmallInt
  noShowGraceMin        Int          @default(15) @map("no_show_grace_min") @db.SmallInt
  maxActiveBookings     Int          @default(3) @map("max_active_bookings") @db.SmallInt
  walkinEnabled         Boolean      @default(false) @map("walkin_enabled")
  walkinDailyCapacity   Int?         @map("walkin_daily_capacity") @db.SmallInt
  walkinOpensOffsetMin  Int          @default(0) @map("walkin_opens_offset_min") @db.SmallInt
  walkinClosesBeforeMin Int          @default(60) @map("walkin_closes_before_min") @db.SmallInt
  version               Int          @default(0)
  createdByUserId       String?      @map("created_by_user_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy     User?                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  members       ClinicMember[]
  doctors       Doctor[]
  businessHours ClinicBusinessHour[]
  closures      ClinicClosure[]
  services      ClinicService[]
  doctorService DoctorService[]
  availability  DoctorAvailability[]
  exceptions    ScheduleException[]
  patients      Patient[]
  appointments  Appointment[]
  accessTokens  PublicAccessToken[]
  idempotency   IdempotencyRecord[]
  queueCounters QueueCounter[]
  queueEntries  QueueEntry[]
  events        ClinicEvent[]
  auditEvents   AuditLog[]

  @@map("clinic")
}

model ClinicMember {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId           String       @map("clinic_id") @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  roles              ClinicRole[]
  isActive           Boolean      @default(true) @map("is_active")
  deactivatedAt      DateTime?    @map("deactivated_at") @db.Timestamptz(6)
  createdByMemberId  String?      @map("created_by_member_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic    Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdBy ClinicMember? @relation("MemberCreatedBy", fields: [clinicId, createdByMemberId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "clinic_member_created_by_fkey")
  created   ClinicMember[] @relation("MemberCreatedBy")
  sessions  Session[]
  doctor    Doctor?
  closures  ClinicClosure[]
  exceptions ScheduleException[]
  appointmentsCreated Appointment[] @relation("AppointmentCreatedBy")
  appointmentsUpdated Appointment[] @relation("AppointmentUpdatedBy")
  accessTokens        PublicAccessToken[]
  queueEntriesCreated QueueEntry[]
  countersPaused      QueueCounter[]

  @@unique([clinicId, userId])
  @@unique([clinicId, id])
  @@unique([clinicId, id, userId])
  @@index([userId])
  @@map("clinic_member")
}

model Doctor {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId     String   @map("clinic_id") @db.Uuid
  memberId     String?  @unique @map("member_id") @db.Uuid
  displayName  String   @map("display_name") @db.VarChar(100)
  titleLabel   String?  @map("title_label") @db.VarChar(80)
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic       Clinic               @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  member       ClinicMember?        @relation(fields: [clinicId, memberId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "doctor_member_fkey")
  services     DoctorService[]
  availability DoctorAvailability[]
  exceptions   ScheduleException[]
  appointments Appointment[]
  queueEntries QueueEntry[]
  events       ClinicEvent[]

  @@unique([clinicId, id])
  @@unique([clinicId, memberId])
  @@map("doctor")
}

model ClinicBusinessHour {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  weekday   Int      @db.SmallInt
  startMin  Int      @map("start_min") @db.SmallInt
  endMin    Int      @map("end_min") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@unique([clinicId, id])
  @@map("clinic_business_hour")
}

model ClinicClosure {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId          String        @map("clinic_id") @db.Uuid
  startDate         DateTime      @map("start_date") @db.Date
  endDate           DateTime      @map("end_date") @db.Date
  startMin          Int?          @map("start_min") @db.SmallInt
  endMin            Int?          @map("end_min") @db.SmallInt
  label             String?       @db.VarChar(80)
  createdByMemberId String?       @map("created_by_member_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic    Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  createdBy ClinicMember? @relation(fields: [clinicId, createdByMemberId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "clinic_closure_created_by_fkey")

  @@unique([clinicId, id])
  @@index([clinicId, startDate, endDate])
  @@map("clinic_closure")
}

model ClinicService {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId             String   @map("clinic_id") @db.Uuid
  name                 String   @db.VarChar(80)
  description          String?  @db.VarChar(300)
  durationMin          Int      @map("duration_min") @db.SmallInt
  onlineBookingEnabled Boolean  @map("online_booking_enabled")
  walkInEnabled        Boolean  @map("walk_in_enabled")
  isActive             Boolean  @default(true) @map("is_active")
  displayOrder         Int      @default(0) @map("display_order") @db.SmallInt
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic       Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctors      DoctorService[]
  appointments Appointment[]
  queueEntries QueueEntry[]

  @@unique([clinicId, id])
  @@map("clinic_service")
}

model DoctorService {
  clinicId  String   @map("clinic_id") @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  clinic  Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor  Doctor        @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Cascade, onUpdate: Restrict, map: "doctor_service_doctor_fkey")
  service ClinicService @relation(fields: [clinicId, serviceId], references: [clinicId, id], onDelete: Cascade, onUpdate: Restrict, map: "doctor_service_service_fkey")

  @@id([doctorId, serviceId])
  @@index([clinicId, serviceId])
  @@map("doctor_service")
}

model DoctorAvailability {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  weekday   Int      @db.SmallInt
  startMin  Int      @map("start_min") @db.SmallInt
  endMin    Int      @map("end_min") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor Doctor @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Cascade, onUpdate: Restrict, map: "doctor_availability_doctor_fkey")

  @@unique([clinicId, id])
  @@map("doctor_availability")
}

model ScheduleException {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId          String                @map("clinic_id") @db.Uuid
  doctorId          String                @map("doctor_id") @db.Uuid
  exceptionDate     DateTime              @map("exception_date") @db.Date
  kind              ScheduleExceptionKind
  startMin          Int?                  @map("start_min") @db.SmallInt
  endMin            Int?                  @map("end_min") @db.SmallInt
  reason            String?               @db.VarChar(200)
  createdByMemberId String?               @map("created_by_member_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic    Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor    Doctor        @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Cascade, onUpdate: Restrict, map: "schedule_exception_doctor_fkey")
  createdBy ClinicMember? @relation(fields: [clinicId, createdByMemberId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "schedule_exception_created_by_fkey")

  @@unique([clinicId, id])
  @@index([clinicId, doctorId, exceptionDate])
  @@map("schedule_exception")
}

model AuditLog {
  id          BigInt    @id @default(autoincrement())
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  clinicId    String?   @map("clinic_id") @db.Uuid
  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String    @db.VarChar(60)
  entityType  String    @map("entity_type") @db.VarChar(40)
  entityId    String?   @map("entity_id") @db.Uuid
  fromStatus  String?   @map("from_status") @db.VarChar(30)
  toStatus    String?   @map("to_status") @db.VarChar(30)
  reason      String?   @db.VarChar(200)
  requestId   String?   @map("request_id") @db.Uuid
  ipHash      Bytes?    @map("ip_hash")
  changes     Json?

  clinic    Clinic? @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([clinicId, occurredAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// SC-2A (Arch 11.12): clinic-scoped operational patient record — name and phone only (FR-PAT-001).
// phone_last4 is a GENERATED column created by hand-written SQL; the application never writes it.
model Patient {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId       String        @map("clinic_id") @db.Uuid
  fullName       String        @map("full_name") @db.VarChar(100)
  nameNormalized String        @map("name_normalized") @db.VarChar(100)
  phoneE164      String?       @map("phone_e164") @db.VarChar(16)
  noPhoneReason  String?       @map("no_phone_reason") @db.VarChar(200)
  phoneLast4     String?       @map("phone_last4") @db.Char(4)
  source         PatientSource
  anonymizedAt   DateTime?     @map("anonymized_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  queueEntries QueueEntry[]

  @@unique([clinicId, id])
  @@index([clinicId, phoneE164])
  @@map("patient")
}

// SC-2B (Arch 11.13): reservation holds (PENDING) and the appointment lifecycle (SRS 9.1–9.2).
// The exclusion constraint, partial indexes, CHECKs and status guard trigger are hand-written SQL (ADR-006, ADR-016, ADR-019).
model Appointment {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId              String             @map("clinic_id") @db.Uuid
  doctorId              String             @map("doctor_id") @db.Uuid
  serviceId             String             @map("service_id") @db.Uuid
  patientId             String?            @map("patient_id") @db.Uuid
  channel               AppointmentChannel
  status                AppointmentStatus  @default(PENDING)
  serviceDate           DateTime           @map("service_date") @db.Date
  startAt               DateTime           @map("start_at") @db.Timestamptz(6)
  endAt                 DateTime           @map("end_at") @db.Timestamptz(6)
  bookingReference      String?            @map("booking_reference") @db.VarChar(11)
  reservationSecretHash Bytes?             @map("reservation_secret_hash")
  holdExpiresAt         DateTime?          @map("hold_expires_at") @db.Timestamptz(6)
  holdClientHash        Bytes?             @map("hold_client_hash")
  holdIpHash            Bytes?             @map("hold_ip_hash")
  confirmedAt           DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  checkedInAt           DateTime?          @map("checked_in_at") @db.Timestamptz(6)
  checkInOverrideReason String?            @map("check_in_override_reason") @db.VarChar(200)
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy           CancelActor?       @map("cancelled_by")
  cancelReason          String?            @map("cancel_reason") @db.VarChar(200)
  noShowAt              DateTime?          @map("no_show_at") @db.Timestamptz(6)
  completedAt           DateTime?          @map("completed_at") @db.Timestamptz(6)
  expiredAt             DateTime?          @map("expired_at") @db.Timestamptz(6)
  createdByMemberId     String?            @map("created_by_member_id") @db.Uuid
  updatedByMemberId     String?            @map("updated_by_member_id") @db.Uuid
  version               Int                @default(0)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic       Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor       Doctor              @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_doctor_fkey")
  service      ClinicService       @relation(fields: [clinicId, serviceId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_service_fkey")
  patient      Patient?            @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_patient_fkey")
  createdBy    ClinicMember?       @relation("AppointmentCreatedBy", fields: [clinicId, createdByMemberId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_created_by_fkey")
  updatedBy    ClinicMember?       @relation("AppointmentUpdatedBy", fields: [clinicId, updatedByMemberId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_updated_by_fkey")
  accessTokens PublicAccessToken[]
  queueEntry   QueueEntry?
  events       ClinicEvent[]

  @@unique([clinicId, id])
  @@unique([clinicId, bookingReference])
  @@index([clinicId, serviceDate, doctorId])
  @@index([clinicId, patientId])
  @@map("appointment")
}

// SC-2B (Arch 11.16): hashed private-link tokens. queue_entry_id gets its composite FK when queue_entry exists (SC-3).
model PublicAccessToken {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId          String             @map("clinic_id") @db.Uuid
  purpose           AccessTokenPurpose
  tokenHash         Bytes              @unique @map("token_hash")
  appointmentId     String?            @map("appointment_id") @db.Uuid
  queueEntryId      String?            @map("queue_entry_id") @db.Uuid
  label             String?            @db.VarChar(60)
  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?            @map("revoke_reason") @db.VarChar(40)
  lastUsedAt        DateTime?          @map("last_used_at") @db.Timestamptz(6)
  createdByMemberId String?            @map("created_by_member_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointment Appointment?  @relation(fields: [clinicId, appointmentId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "public_access_token_appointment_fkey")
  queueEntry  QueueEntry?   @relation(fields: [clinicId, queueEntryId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "public_access_token_queue_entry_fkey")
  createdBy   ClinicMember? @relation(fields: [clinicId, createdByMemberId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "public_access_token_created_by_fkey")

  @@unique([clinicId, id])
  @@map("public_access_token")
}

// SC-2B (Arch 11.19): public POST results kept 24 h for identical replays; bodies AES-256-GCM encrypted (ADR-011).
model IdempotencyRecord {
  clinicId        String           @map("clinic_id") @db.Uuid
  endpoint        String           @db.VarChar(60)
  idemKey         String           @map("idem_key") @db.Uuid
  requestHash     Bytes            @map("request_hash")
  state           IdempotencyState @default(IN_PROGRESS)
  responseStatus  Int?             @map("response_status") @db.SmallInt
  responseBodyEnc Bytes?           @map("response_body_enc")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@id([clinicId, endpoint, idemKey])
  @@index([expiresAt])
  @@map("idempotency_record")
}

// SC-3 (Arch 11.14): one row per clinic-local day; the row lock serialises token allocation (ADR-008).
model QueueCounter {
  clinicId         String    @map("clinic_id") @db.Uuid
  serviceDate      DateTime  @map("service_date") @db.Date
  lastToken        Int       @default(0) @map("last_token")
  walkInCount      Int       @default(0) @map("walk_in_count")
  walkInPaused     Boolean   @default(false) @map("walk_in_paused")
  pausedByMemberId String?   @map("paused_by_member_id") @db.Uuid
  pausedAt         DateTime? @map("paused_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic   Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  pausedBy ClinicMember? @relation(fields: [clinicId, pausedByMemberId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "queue_counter_paused_by_fkey")
  entries  QueueEntry[]

  @@id([clinicId, serviceDate])
  @@map("queue_counter")
}

// SC-3 (Arch 11.15): a patient's place in today's queue (SRS 9.3–9.4). Guards are hand-written SQL.
model QueueEntry {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId               String       @map("clinic_id") @db.Uuid
  serviceDate            DateTime     @map("service_date") @db.Date
  tokenNumber            Int          @map("token_number")
  doctorId               String       @map("doctor_id") @db.Uuid
  serviceId              String       @map("service_id") @db.Uuid
  patientId              String       @map("patient_id") @db.Uuid
  appointmentId          String?      @unique @map("appointment_id") @db.Uuid
  source                 QueueSource
  status                 QueueStatus
  countsTowardCapacity   Boolean      @map("counts_toward_capacity")
  capacityOverrideReason String?      @map("capacity_override_reason") @db.VarChar(200)
  registeredAt           DateTime     @default(now()) @map("registered_at") @db.Timestamptz(6)
  arrivedAt              DateTime?    @map("arrived_at") @db.Timestamptz(6)
  sortTime               DateTime?    @map("sort_time") @db.Timestamptz(6)
  firstCalledAt          DateTime?    @map("first_called_at") @db.Timestamptz(6)
  lastCalledAt           DateTime?    @map("last_called_at") @db.Timestamptz(6)
  startedAt              DateTime?    @map("started_at") @db.Timestamptz(6)
  completedAt            DateTime?    @map("completed_at") @db.Timestamptz(6)
  endedAt                DateTime?    @map("ended_at") @db.Timestamptz(6)
  recallCount            Int          @default(0) @map("recall_count") @db.SmallInt
  autoClosed             Boolean      @default(false) @map("auto_closed")
  cancelledBy            CancelActor? @map("cancelled_by")
  endReason              String?      @map("end_reason") @db.VarChar(200)
  createdByMemberId      String?      @map("created_by_member_id") @db.Uuid
  version                Int          @default(0)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic       Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  counter      QueueCounter        @relation(fields: [clinicId, serviceDate], references: [clinicId, serviceDate], onDelete: Restrict, onUpdate: Restrict, map: "queue_entry_counter_fkey")
  doctor       Doctor              @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "queue_entry_doctor_fkey")
  service      ClinicService       @relation(fields: [clinicId, serviceId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "queue_entry_service_fkey")
  patient      Patient             @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "queue_entry_patient_fkey")
  appointment  Appointment?        @relation(fields: [clinicId, appointmentId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "queue_entry_appointment_fkey")
  createdBy    ClinicMember?       @relation(fields: [clinicId, createdByMemberId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict, map: "queue_entry_created_by_fkey")
  accessTokens PublicAccessToken[]
  events       ClinicEvent[]

  @@unique([clinicId, id])
  @@unique([clinicId, serviceDate, tokenNumber])
  @@unique([clinicId, appointmentId])
  @@index([clinicId, serviceDate, doctorId, status, sortTime, tokenNumber])
  @@map("queue_entry")
}

// SC-3 (Arch 11.20): transactional outbox for SSE fan-out (ADR-012). PII-free payloads (ADR-026).
model ClinicEvent {
  id            BigInt   @id @default(autoincrement())
  clinicId      String   @map("clinic_id") @db.Uuid
  type          String   @db.VarChar(40)
  doctorId      String?  @map("doctor_id") @db.Uuid
  queueEntryId  String?  @map("queue_entry_id") @db.Uuid
  appointmentId String?  @map("appointment_id") @db.Uuid
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor      Doctor?      @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Cascade, onUpdate: Restrict, map: "clinic_event_doctor_fkey")
  queueEntry  QueueEntry?  @relation(fields: [clinicId, queueEntryId], references: [clinicId, id], onDelete: Cascade, onUpdate: Restrict, map: "clinic_event_queue_entry_fkey")
  appointment Appointment? @relation(fields: [clinicId, appointmentId], references: [clinicId, id], onDelete: Cascade, onUpdate: Restrict, map: "clinic_event_appointment_fkey")

  @@index([clinicId, id])
  @@index([createdAt])
  @@map("clinic_event")
}
