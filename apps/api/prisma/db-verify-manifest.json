    { "role": "sc_app", "table": "audit_log", "privilege": "SELECT", "expected": true },
    { "role": "sc_app", "table": "audit_log", "privilege": "UPDATE", "expected": false },
    { "role": "sc_app", "table": "audit_log", "privilege": "DELETE", "expected": false },
    { "role": "sc_app", "table": "audit_log", "privilege": "TRUNCATE", "expected": false },
    { "role": "sc_app", "table": "clinic", "privilege": "UPDATE", "expected": true }
